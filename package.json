{
  "name": "tuscany-storage",
  "version": "1.0.0",
  "description": "Tuscany Village Self Storage — Full-stack platform replacing Storable Easy. Next.js 14 + MongoDB + Stripe.",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "NODE_OPTIONS=--max-old-space-size=4096 next build",
    "start": "next start",
    "lint": "next lint",
    "seed": "ts-node --project tsconfig.scripts.json scripts/seed.ts",
    "seed:promo": "ts-node --project tsconfig.scripts.json scripts/seed-promo.ts",
    "seed:customers": "ts-node --project tsconfig.scripts.json scripts/seed-customers.ts",
    "seed:products": "ts-node --project tsconfig.scripts.json scripts/seed-products.ts",
    "seed:settings": "ts-node --project tsconfig.scripts.json scripts/seed-settings.ts",
    "seed:fees": "ts-node --project tsconfig.scripts.json scripts/seed-fees.ts",
    "sync:units": "ts-node --project tsconfig.scripts.json scripts/sync-units.ts",
    "import:transactions": "ts-node --project tsconfig.scripts.json scripts/import-transactions.ts",
    "import:rent-charges": "ts-node --project tsconfig.scripts.json scripts/generate-rent-charges.ts",
    "import:credits": "ts-node --project tsconfig.scripts.json scripts/import-credits.ts",
    "backfill:leases": "ts-node --project tsconfig.scripts.json scripts/backfill-leases.ts",
    "backfill:payment-direction": "ts-node --project tsconfig.scripts.json scripts/backfill-payment-direction.ts",
    "backfill:balance-after": "ts-node --project tsconfig.scripts.json scripts/backfill-balance-after.ts",
    "migrate:local-to-atlas": "ts-node --project tsconfig.scripts.json scripts/migrate-local-to-atlas.ts",
    "seed:alan-wolfe": "ts-node --project tsconfig.scripts.json scripts/seed-alan-wolfe.ts",
    "import:billing": "ts-node --project tsconfig.scripts.json scripts/import-billing-history.ts",
    "feed:billing": "tsx --env-file=.env.local scripts/feed-billing.ts",
    "billing:preview": "node scripts/run-recurring-billing.js --dry",
    "billing:run": "node scripts/run-recurring-billing.js",
    "migrate": "ts-node --project tsconfig.scripts.json scripts/migrate.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "e2e:debug": "playwright test --debug",
    "e2e:codegen": "playwright codegen http://localhost:3000",
    "e2e:report": "playwright show-report"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isahive/tuscany-storage.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/isahive/tuscany-storage/issues"
  },
  "homepage": "https://github.com/isahive/tuscany-storage#readme",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1027.0",
    "@aws-sdk/s3-request-presigner": "^3.1027.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^5.16.14",
    "@mui/material": "^5.16.14",
    "@mui/x-data-grid": "^7.27.2",
    "@stripe/react-stripe-js": "^2.9.0",
    "@stripe/stripe-js": "^4.10.0",
    "@tiptap/extension-character-count": "^3.22.3",
    "@tiptap/extension-highlight": "^3.22.3",
    "@tiptap/extension-image": "^3.22.3",
    "@tiptap/extension-placeholder": "^3.22.3",
    "@tiptap/extension-text-align": "^3.22.3",
    "@tiptap/extension-typography": "^3.22.3",
    "@tiptap/extension-underline": "^3.22.3",
    "@tiptap/react": "^3.22.3",
    "@tiptap/starter-kit": "^3.22.3",
    "bcryptjs": "^3.0.3",
    "mongoose": "^9.4.1",
    "next": "^14.2.35",
    "next-auth": "^4.24.13",
    "node-cron": "^4.2.1",
    "pdfkit": "^0.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^4.0.0",
    "stripe": "^22.0.0",
    "twilio": "^5.13.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^25.5.2",
    "@types/node-cron": "^3.0.11",
    "@types/pdfkit": "^0.17.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.7",
    "@vitest/ui": "^4.1.6",
    "autoprefixer": "^10.4.20",
    "dotenv": "^17.4.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.29",
    "happy-dom": "^20.9.0",
    "mongodb-memory-server": "^11.1.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2",
    "vitest": "^4.1.6"
  }
}
